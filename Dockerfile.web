# syntax=docker/dockerfile:1
#
# apps/web — Next.js 15 (App Router). Built with Bun (fast `next build`) but RUN
# ON THE NODE RUNTIME. Reason: `next start` under Bun leaked RSS (~8 Mi/min) and
# OOM-looped, which is what forced a second cluster node. better-sqlite3 (a
# native N-API addon) replaces bun:sqlite so the web app is fully Node-native.
# Only the web app opens SQLite; the scanner/bot are pure API clients (Bun).
#
# Migrations apply at server boot via apps/web/instrumentation.ts, then Next
# serves on :3000. SQLite lives on the mounted PVC (single-writer rule).

FROM oven/bun:1.3.13 AS base
WORKDIR /app

# ---- deps: install the whole workspace (dev deps are needed to build Next) ----
FROM base AS deps
# better-sqlite3 is native and has no prebuilt for Bun's emulated Node ABI, so
# `bun install` falls back to node-gyp — which needs a C++ toolchain. (This build
# of the binary is throwaway; the Node runtime stage reinstalls it via npm.)
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY package.json bun.lock tsconfig.base.json ./
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json   packages/db/package.json
COPY apps/web/package.json       apps/web/package.json
COPY apps/scanner/package.json   apps/scanner/package.json
COPY apps/bot/package.json       apps/bot/package.json
RUN bun install --frozen-lockfile

# ---- build: compile the Next.js app ----
FROM deps AS build
COPY . .
RUN cd apps/web && bun run build

# ---- native deps: better-sqlite3 built for the Node 22 ABI, in a clean tree ----
# npm can't --prefix into Bun's node_modules layout (it errors), so build this one
# native package standalone here and overlay it onto the runtime tree below.
FROM node:22-slim AS nativedeps
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /native
RUN npm init -y >/dev/null && npm install --no-save better-sqlite3@12.11.1

# ---- runtime: Node 22 (NOT Bun) ----
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV AIX_DB_PATH=/data/aix.db
COPY --from=build /app /app
# better-sqlite3 gets bundled into .next, so at runtime its `bindings` loader
# searches .next/build/Release for the native binary. Drop the Node-22-ABI
# build there (and overlay the module too, belt-and-suspenders).
COPY --from=nativedeps /native/node_modules/better-sqlite3 /app/node_modules/better-sqlite3
COPY --from=nativedeps /native/node_modules/better-sqlite3/build/Release/better_sqlite3.node /app/apps/web/.next/build/Release/better_sqlite3.node
EXPOSE 3000
# Migrations run at boot (instrumentation.ts); then Next serves on :3000.
CMD ["sh", "-c", "cd apps/web && exec npx --no-install next start -p 3000"]
