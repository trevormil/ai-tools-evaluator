# ---- AIx local dev env (copy to .env; k8s uses the aix-secrets Secret) ----

# Storage + internal auth
AIX_DB_PATH=./aix.db
AIX_INTERNAL_TOKEN=dev-internal-token           # shared secret: scanner/bot -> web internal API
AIX_PUBLIC_URL=http://localhost:3000            # base URL for email links

# Web: GitHub OAuth (create an OAuth app; callback -> /api/auth/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Scanner: discovery + evaluation
GITHUB_TOKEN=                                   # authed Octokit (higher rate limits)
ANTHROPIC_API_KEY=
AIX_MODEL=claude-opus-4-8
AIX_DAILY_CAP=10
AIX_TRENDING_PICKS=10                           # trending repos LLM-scored+saved per scan (Discord still features 1/day)
AIX_WEB_URL=http://localhost:3000
# AIX_DRY_RUN=1                                 # discover+evaluate, don't publish

# Bot: Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=                               # optional: fast guild-scoped command registration
DISCORD_DIGEST_CHANNEL_ID=

# Newsletter: Resend free tier (unset RESEND_API_KEY => emails are logged only)
RESEND_API_KEY=
NEWSLETTER_FROM=AIx <newsletter@aix.trevormil.com>

# Object storage: DigitalOcean Spaces (profile pics / uploads). Leave unset to disable uploads.
AIX_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
AIX_SPACES_REGION=nyc3
AIX_SPACES_BUCKET=aix-trevormil-media
AIX_SPACES_KEY=
AIX_SPACES_SECRET=
AIX_MEDIA_BASE_URL=https://aix-trevormil-media.nyc3.digitaloceanspaces.com
