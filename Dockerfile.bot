# syntax=docker/dockerfile:1
#
# apps/bot — Discord bot. Long-lived bun process (k8s Deployment). Built from
# the repo ROOT so the workspace package @aix/core resolves. The bot never
# opens SQLite; it calls web's internal API (/submissions, /digest).

FROM oven/bun:1.3.13 AS base
WORKDIR /app

# ---- deps: install the workspace (manifests first for layer caching) ----
FROM base AS deps
COPY package.json bun.lock tsconfig.base.json ./
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json   packages/db/package.json
COPY apps/web/package.json       apps/web/package.json
COPY apps/scanner/package.json   apps/scanner/package.json
COPY apps/bot/package.json       apps/bot/package.json
RUN bun install --frozen-lockfile

# ---- build: deps + full source (carries per-workspace node_modules) ----
FROM deps AS build
COPY . .

# ---- runtime: whole /app tree so nested workspace node_modules resolve ----
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app /app
# Long-running process — the Deployment keeps it alive.
CMD ["bun", "apps/bot/src/index.ts"]
