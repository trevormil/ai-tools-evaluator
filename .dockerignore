# Never ship deps into the image — they're installed inside the build.
**/node_modules

# VCS / tooling / agent state
.git
.github
.gitlab
.TerMinal
.serena
.claude
.codex
.agents

# Build output & local runtime artifacts
.next
**/.next
dist
**/dist
build
**/build

# Local SQLite (the real DB lives on the PVC)
*.db
*.db-wal
*.db-shm

# Secrets & env — injected via k8s Secrets, never baked in
.env
.env.*
*.pem
*.key
secrets/

# Generated markdown archive (regenerated at runtime)
content/items/*.md

# OS / editor cruft
.DS_Store
*.log
