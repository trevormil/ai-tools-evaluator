{
  "name": "aix",
  "version": "0.1.0",
  "private": true,
  "description": "AIx — discover trending GitHub tools and discuss them. A dual directory + social site.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "cd apps/web && bun run dev",
    "scanner": "cd apps/scanner && bun run start",
    "bot": "cd apps/bot && bun run start",
    "db:push": "cd packages/db && bun run push",
    "seed": "cd packages/db && bun src/seed.ts",
    "db:studio": "cd packages/db && bun run studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test packages apps",
    "test:e2e": "cd e2e && bun run test",
    "typecheck": "bun run --filter '*' typecheck",
    "spaces:setup": "bun scripts/spaces-setup.ts"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "aws4fetch": "1.0.20",
    "prettier": "3.4.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
