{
  "name": "aix",
  "version": "0.1.0",
  "private": true,
  "description": "AIx — discover trending GitHub tools and discuss them. A dual directory + social site.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "web": "cd apps/web && bun run dev",
    "scanner": "cd apps/scanner && bun run start",
    "bot": "cd apps/bot && bun run start",
    "db:push": "cd packages/db && bun run push",
    "db:studio": "cd packages/db && bun run studio",
    "test": "bun test",
    "typecheck": "tsc --build --verbose"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "typescript": "5.7.2",
    "prettier": "3.4.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
