{
  "name": "aix",
  "version": "0.1.0",
  "private": true,
  "description": "AIx — a static, git-native directory of trending AI/GitHub tools, each with a harsh, honest AI evaluation.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "web": "cd apps/web && bun run dev",
    "scanner": "cd apps/scanner && bun run start",
    "db:push": "cd packages/db && bun run push",
    "seed": "cd packages/db && bun src/seed.ts",
    "db:studio": "cd packages/db && bun run studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test packages apps workers",
    "test:e2e": "cd e2e && bun run test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "prettier": "3.4.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
